# Copy to .env.local. Leave secrets empty until you have real values. Never commit real keys.

# --- App / branding (optional) ---
NEXT_PUBLIC_PACTOPUS_NAME=Pactopus
NEXT_PUBLIC_PACTOPUS_TAGLINE=Solana Seeker & SPL Stablecoin Invoicing. Settled.
NEXT_PUBLIC_SITE_URL=

# --- Solana & Solana Seeker (Primary Engine) ---
# Cluster: mainnet-beta or devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com
# SPL Token Mint Addresses (defaults to official Circle USDC/EURC mints if unset)
NEXT_PUBLIC_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_SOLANA_EURC_MINT=HzwqbKZw8HxMN6bF2yFZNrht3c2iXXzpKcFu7uBEDKtr
# Kyrvyn Ltd Solana Treasury Public Key (Base58, receives the capped 0.25% / 0.50% fee)
NEXT_PUBLIC_SOLANA_PLATFORM_WALLET=7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
# Optional: Solana Seeker Genesis Token Collection Mint for on-chain holder verification
NEXT_PUBLIC_SEEKER_GENESIS_COLLECTION_MINT=
# Default GBP FX Reference Rates for locked UK accounting records
NEXT_PUBLIC_DEFAULT_USD_TO_GBP=0.79
NEXT_PUBLIC_DEFAULT_EUR_TO_GBP=0.85

# --- Legacy Compatibility Adapters (Arc / Algorand) ---
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=
NEXT_PUBLIC_PLATFORM_WALLET=
NEXT_PUBLIC_ALGO_PLATFORM_WALLET=

# --- Wallets ---
# Optional: enables the WalletConnect option when set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Database (Neon / PostgreSQL) ---
# Pooled URL used by the app at runtime.
DATABASE_URL=
# Direct (non-pooler) URL used only by prisma migrate.
DIRECT_DATABASE_URL=

# --- Circle (Checkout & Developer-Controlled Wallets) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_WEBHOOK_SIGNING_SECRET=

# --- Agent & Treasury routes ---
ARC_AGENT_PRIVATE_KEY=
ARC_YIELD_VAULT_ADDRESS=
PAYMASTER_SIGNER_KEY=
NEXT_PUBLIC_PAYMASTER_ADDRESS=
PAYMASTER_MIN_ALLOWANCE_RAW=0
PAYMASTER_DAILY_BUDGET_RAW=1000000000
# Operator token (min 24 chars) for /api/agent/treasury-sweep and /api/agent/paymaster-sponsor.
# Those routes stay disabled while this is empty.
AGENT_ADMIN_TOKEN=

# --- Dev-only toggles (leave unset in production) ---
PACTOPUS_LOG_SQL=
PACTOPUS_ALLOW_DEMO_STORE_FALLBACK=
PACTOPUS_ALLOW_UNSAFE_PAYMASTER_SIGNER=
