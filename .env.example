# Copy to .env.local. Leave secrets empty until you have real values. Never commit real keys.

# --- App / branding (optional) ---
NEXT_PUBLIC_PACTOPUS_NAME=Pactopus
NEXT_PUBLIC_PACTOPUS_TAGLINE=Stablecoin invoicing. Settled.
NEXT_PUBLIC_SITE_URL=

# --- Arc (EVM) testnet ---
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
# Required (the app refuses to start without a valid 0x address). Set the real token contract.
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=
# Treasury that receives the platform fee. Required, 0x + 40 hex.
NEXT_PUBLIC_PLATFORM_WALLET=

# --- Algorand TestNet ---
# Treasury address; must have opted in to the USDC/EURC TestNet assets.
NEXT_PUBLIC_ALGO_PLATFORM_WALLET=

# --- Wallets ---
# Optional: enables the WalletConnect option when set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Database (Neon / PostgreSQL) ---
# Pooled URL used by the app at runtime.
DATABASE_URL=
# Direct (non-pooler) URL used only by prisma migrate.
DIRECT_DATABASE_URL=

# --- Circle (Checkout & Developer-Controlled Wallets) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_WEBHOOK_SIGNING_SECRET=

# --- Agent & Treasury routes ---
ARC_AGENT_PRIVATE_KEY=
ARC_YIELD_VAULT_ADDRESS=
PAYMASTER_SIGNER_KEY=
NEXT_PUBLIC_PAYMASTER_ADDRESS=
PAYMASTER_MIN_ALLOWANCE_RAW=0
PAYMASTER_DAILY_BUDGET_RAW=1000000000
# Operator token (min 24 chars) for /api/agent/treasury-sweep and /api/agent/paymaster-sponsor.
# Those routes stay disabled while this is empty.
AGENT_ADMIN_TOKEN=

# --- Dev-only toggles (leave unset in production) ---
PACTOPUS_LOG_SQL=
PACTOPUS_ALLOW_DEMO_STORE_FALLBACK=
PACTOPUS_ALLOW_UNSAFE_PAYMASTER_SIGNER=
