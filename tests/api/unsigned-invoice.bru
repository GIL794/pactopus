meta {
  name: Unsigned invoice creation rejected
  type: http
  seq: 1
}
post {
  url: http://127.0.0.1:4317/api/invoices
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"amount":"1.00","currency":"USDC","description":"Synthetic unsigned test","recipientAddress":"0x0000000000000000000000000000000000000003","network":"arc"}
}
tests {
  test("rejects unsigned write with 401", function () {
    expect(res.status).to.equal(401);
    expect(res.body.authRequired).to.equal(true);
  });
}
